         <dc:subject>
            <rdf:Bag>
               <rdf:li>10.1002/2015JD023137 and air temperature variability over glaciers; katabatic wind; melt modeling; temperature extrapolation; temperature lapse rates; boundary layer meteorology</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Modeling 2â€‰m air temperatures over mountain glaciers: Exploring the influence of katabatic cooling and external warming</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
